{
  "name": "@michalwo/string-similarity",
  "version": "1.0.0",
  "description": "Finds degree of similarity between strings, based on Dice's Coefficient.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run test && npm run build",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "strings",
    "similar",
    "difference",
    "similarity",
    "compare",
    "comparison",
    "degree",
    "match",
    "matching",
    "dice",
    "typescript"
  ],
  "author": "Michał Worwag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michal-worwag/string-similarity"
  },
  "bugs": {
    "url": "https://github.com/michal-worwag/string-similarity/issues"
  },
  "homepage": "https://github.com/michal-worwag/string-similarity#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
